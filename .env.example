# ==============================================================================
# Environment Configuration Template
# OWASP Compliance: Never commit actual .env files containing real credentials!
# Local testing: Copy this file to .env and configure values.
# CI/CD (GitHub Actions): Configure values in GitHub Repository Secrets & Variables.
# ==============================================================================

# Application Base URL (GitHub Actions: configure in Repository Variables -> BASE_URL)
BASE_URL=https://automationexercise.com

# Test User Credentials (GitHub Actions: configure in Repository Secrets -> TEST_USER_EMAIL / TEST_USER_PASSWORD)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=SecurePassword123!

# Test Execution Concurrency & Debugging
WORKERS=1
SLOWMO=0
CI=false
